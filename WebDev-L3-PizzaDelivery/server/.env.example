# ===================================================================
# PizzaVerse Backend Environment Variables (.env.example)
# Duplicate this file as .env and populate with your environment values.
# ===================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (For CORS and email verification links)
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/pizzaverse
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/pizzaverse?retryWrites=true&w=majority
# Embedded fallback for instant zero-config testing: set USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/pizzaverse
USE_MEMORY_DB=false

# JSON Web Token Secret (generate using `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Cookie Security Secret
COOKIE_SECRET=your_super_secret_cookie_signing_key_replace_in_production

# Mailer / SMTP Configuration
# In development, leave blank to automatically use ephemeral Ethereal test accounts with browser preview links!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PizzaVerse Artisanal" <noreply@pizzaverse.local>
EMAIL_SERVICE=ethereal

# Razorpay Payment Gateway (Test Mode)
# Retrieve your test key pair from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_PVTestKey2026
RAZORPAY_KEY_SECRET=pv_sec_test_SecretKey2026
RAZORPAY_WEBHOOK_SECRET=pv_whsec_test_WebhookKey2026

# Admin & Inventory Management Configuration (Part 4)
ADMIN_NOTIFICATION_EMAIL=admin.inventory@pizzaverse.local
INVENTORY_CHECK_CRON=0 * * * *
ADMIN_DEFAULT_EMAIL=admin@pizzaverse.local
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_min_8_chars


